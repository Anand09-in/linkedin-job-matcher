# ── LinkedIn ──────────────────────────────────────────────────────────────────
# How to get: LinkedIn → DevTools → Application → Cookies → li_at value
# Expires ~every 30 days — refresh when scraping fails
LI_AT_COOKIE=your_linkedin_li_at_cookie_here

# ── LLM Provider (swap one line to change model) ─────────────────────────────
LLM_PROVIDER=groq                        # anthropic | openai | groq | gemini | ollama | bedrock
LLM_MODEL=llama-3.3-70b-versatile        # model name for the chosen provider
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2000

# Provider API Keys — fill in only the one matching LLM_PROVIDER
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
GOOGLE_API_KEY=

# ── AWS Bedrock (if LLM_PROVIDER=bedrock) ────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
BEDROCK_MODEL=meta.llama3-8b-instruct-v1:0

# ── Ollama (local, no API key needed) ────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./data/jobs.db

# ── Background Scheduler ──────────────────────────────────────────────────────
SCHEDULER_ENABLED=false                  # set true to auto-scrape on a schedule
SCHEDULER_INTERVAL_HOURS=12

# ── Scraper ───────────────────────────────────────────────────────────────────
SCRAPER_BACKOFF_BASE=5.0                 # base seconds for 429 exponential backoff

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
