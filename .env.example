# ── LinkedIn ──────────────────────────────────────────────────────────────────
# How to get: LinkedIn → DevTools → Application → Cookies → li_at value
LI_AT_COOKIE=your_linkedin_li_at_cookie_here

# ── LLM Provider (swap to change model) ──────────────────────────────────────
LLM_PROVIDER=groq                  # options: anthropic | openai | groq | ollama | gemini | bedrock
LLM_MODEL=llama-3.3-70b-versatile
BEDROCK_MODEL=meta.llama3-8b-instruct-v1:0

# Provider API Keys — fill in only the one you use
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
GOOGLE_API_KEY=

# ── AWS Bedrock (if LLM_PROVIDER=bedrock) ────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1

# ── Ollama (local, fully free) ────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./data/jobs.db

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
