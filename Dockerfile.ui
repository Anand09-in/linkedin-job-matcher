# Streamlit UI — lightweight, no Chrome needed
FROM python:3.12-slim

WORKDIR /app

# Only UI dependencies (subset of requirements.txt)
RUN pip install --no-cache-dir \
    streamlit==1.58.0 \
    httpx==0.28.1 \
    plotly==6.7.0 \
    pandas==2.3.3 \
    loguru==0.7.3

COPY ui/ ./ui/
COPY config/ ./config/

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

EXPOSE 8501

CMD ["streamlit", "run", "ui/app.py", \
     "--server.port=8501", \
     "--server.address=0.0.0.0", \
     "--server.headless=true"]
