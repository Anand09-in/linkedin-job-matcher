# Copy to .env and fill in. All ports are configurable to avoid the host-port
# collisions v1 hit during development (FR-9.3) — change *_PORT if 8000/5173/
# 5432/6379 are already taken on your machine.

# ── Ports (host-side; change if occupied) ───────────────────────────────────
API_PORT=8000
FRONTEND_PORT=5173
POSTGRES_PORT=5432
REDIS_PORT=6379

# ── Postgres ──────────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=job_matcher
# Consumed by the api/worker containers (points at the `postgres` service by
# Docker DNS name, not localhost — only relevant if overriding manually).
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/job_matcher

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Frontend -> API (browser-side, so it's localhost + the published port) ──
VITE_API_BASE_URL=http://localhost:8000

# ── LinkedIn ──────────────────────────────────────────────────────────────────
# LinkedIn -> DevTools -> Application -> Cookies -> li_at value. Expires
# ~every 30 days. Not needed until Phase 2 (scraper adapter) lands.
LI_AT_COOKIE=

# ── LLM Provider (swap one line to change model — FR-3) ──────────────────────
LLM_PROVIDER=groq                        # anthropic | openai | groq | gemini | ollama | bedrock
LLM_MODEL=llama-3.3-70b-versatile
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2000

# Provider API keys — fill in only the one matching LLM_PROVIDER
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
GOOGLE_API_KEY=

# ── AWS Bedrock (if LLM_PROVIDER=bedrock) ────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
BEDROCK_MODEL=anthropic.claude-3-haiku-20240307-v1:0

# ── Ollama (local, no API key needed) ────────────────────────────────────────
OLLAMA_BASE_URL=http://host.docker.internal:11434

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
