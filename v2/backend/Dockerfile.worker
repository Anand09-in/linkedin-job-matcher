# ── Worker service ────────────────────────────────────────────────────────────
# Runs the scrape pipeline (Playwright, Phase 2) and arq background tasks.
#
# Built FROM Playwright's own official image rather than bolting
# `playwright install --with-deps` onto python:3.12-slim: that combination
# broke outright during Phase 2 — python:3.12-slim now tracks Debian
# "trixie", and Playwright 1.49.x's --with-deps fallback logic still expects
# Ubuntu 20.04 package names (ttf-ubuntu-font-family, ttf-unifont) that don't
# exist there. The official image ships Chromium + every OS-level dependency
# already version-matched to the pip package below — pin them to the exact
# same release (v1.49.0-noble <-> playwright==1.49.0 in requirements-worker.txt).
FROM mcr.microsoft.com/playwright/python:v1.49.0-noble

WORKDIR /app
COPY requirements-worker.txt requirements.txt ./
RUN pip install --no-cache-dir -r requirements-worker.txt

COPY . .

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

CMD ["arq", "app.workers.worker_app.WorkerSettings"]
