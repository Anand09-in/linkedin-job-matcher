# ── Frontend — production build (FR-9.2) ────────────────────────────────────
# Multi-stage: `npm run build` (tsc + vite build) produces a static bundle,
# served by Nginx — no Node process, no dev server, in production. The dev
# Dockerfile (Vite dev server + HMR) is what `docker compose up` uses; this
# is for an actual deployment.
FROM node:22-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm install --legacy-peer-deps
COPY . .
# VITE_API_BASE_URL is baked into the static JS bundle at build time (Vite
# env vars are compile-time, not runtime) — pass it as a build arg so a prod
# deployment can point at its real API origin instead of localhost:8000.
ARG VITE_API_BASE_URL=http://localhost:8000
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
RUN npm run build

FROM nginx:1.27-alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
